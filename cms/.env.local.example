# GitHub — create a Personal Access Token at github.com/settings/tokens (needs repo scope)
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=Orelis-HQ
CONTENT_PATH=content

# Auth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret
NEXTAUTH_URL=http://localhost:3001

# Shared password — everyone on the team uses this to get in
CMS_PASSWORD=your_shared_password
